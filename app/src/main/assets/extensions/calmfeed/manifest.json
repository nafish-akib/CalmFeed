{
  "manifest_version": 2,
  "name": "CalmFeed Filters",
  "version": "1.4.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "calmfeed-filters@calmfeed.app",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["filters.js"],
      "run_at": "document_start"
    }
  ]
}
